// HeyOtto Tasks på Cloudflare Workers. Se worker/index.mts og projects/heyotto-os-iterationer/M10-cloudflare-fundament.md.
//
//   npm run cf:dev            lokalt (Miniflare: lokal D1, kø og cron)
//   npm run cf:deploy:test    testmiljøet (egen database og kø)
//
// Hemmeligheder sættes med `npx wrangler secret put <NAVN> [--env test]` og står aldrig her:
//   HEYOTTO_PASSWORD, ANTHROPIC_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
//   CLAUDE_ROUTINE_URL, CLAUDE_ROUTINE_TOKEN
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heyotto-tasks",
  "main": "worker/index.mts",
  "compatibility_date": "2026-09-01",
  // node:crypto og process.env (hemmelighederne ligger også i process.env, som Claude-SDK'et læser)
  "compatibility_flags": ["nodejs_compat"],
  // Workeren kører før de statiske filer, så adgangsvagten (server/gate.mts) også gælder dem
  "assets": { "directory": "./dashboard", "binding": "ASSETS", "run_worker_first": true },
  // Kun de egne adresser: ingen workers.dev- eller preview-adresser uden om vagten
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *", "0 * * * *"] },

  // Produktion (M13). database_id udfyldes, når databasen er oprettet:
  //   npx wrangler d1 create heyotto-tasks
  "routes": [
    { "pattern": "tasks-ui.heyotto.win", "custom_domain": true },
    { "pattern": "tasks.heyotto.win", "custom_domain": true }
  ],
  "vars": {
    "APP_URL": "https://tasks-ui.heyotto.win",
    "UI_HOST": "tasks-ui.heyotto.win",
    "API_HOST": "tasks.heyotto.win",
    "CF_ACCESS_TEAM_DOMAIN": "old-dust-74a9.cloudflareaccess.com",
    "CF_ACCESS_AUD": ""
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "heyotto-tasks", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // /ext og /mcp: højst 60 kald i minuttet pr. token
  "ratelimits": [{ "name": "EXT_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "queues": {
    "producers": [{ "binding": "AGENT_QUEUE", "queue": "heyotto-tasks-otto" }],
    "consumers": [{ "queue": "heyotto-tasks-otto", "max_batch_size": 1, "max_retries": 0 }]
  },

  "env": {
    // Testmiljøet: egen database og kø, så en test aldrig rører de rigtige data
    "test": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "tasks-test-ui.heyotto.win", "custom_domain": true },
        { "pattern": "tasks-test.heyotto.win", "custom_domain": true }
      ],
      // CF_ACCESS_AUD: AUD-tagget fra Access-applikationen for tasks-test-ui.heyotto.win
      "vars": {
        "APP_URL": "https://tasks-test-ui.heyotto.win",
        "UI_HOST": "tasks-test-ui.heyotto.win",
        "API_HOST": "tasks-test.heyotto.win",
        "CF_ACCESS_TEAM_DOMAIN": "old-dust-74a9.cloudflareaccess.com",
        "CF_ACCESS_AUD": ""
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "heyotto-tasks-test", "database_id": "cd14081d-2c54-46a0-9e62-8430bbe9d568", "migrations_dir": "migrations" }
      ],
      "ratelimits": [{ "name": "EXT_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }],
      "queues": {
        "producers": [{ "binding": "AGENT_QUEUE", "queue": "heyotto-tasks-otto-test" }],
        "consumers": [{ "queue": "heyotto-tasks-otto-test", "max_batch_size": 1, "max_retries": 0 }]
      }
    }
  }
}
