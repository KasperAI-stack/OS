// HeyOtto Tasks på Cloudflare Workers. Se worker/index.mts og projects/heyotto-os-iterationer/M10–M15.
//
//   npm test                  tests i Node (ingen Cloudflare)
//   npm run cf:migrate        databasens tabeller (D1)
//   npm run cf:deploy         udrul til tasks.heyotto.win og tasks-api.heyotto.win
//
// Hemmeligheder sættes med `npx wrangler secret put <NAVN>` og står aldrig her:
//   ANTHROPIC_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, HEYOTTO_TOKEN (Studio)
//   (HEYOTTO_PASSWORD kun til lokal udvikling uden Cloudflare Access)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heyotto-tasks",
  "main": "worker/index.mts",
  "compatibility_date": "2026-09-01",
  // node:crypto og process.env (hemmelighederne ligger også i process.env, som Claude-SDK'et læser)
  "compatibility_flags": ["nodejs_compat"],
  // Workeren kører før de statiske filer, så adgangsvagten (server/gate.mts) også gælder dem
  "assets": { "directory": "./dashboard", "binding": "ASSETS", "run_worker_first": true },
  // Kun de egne adresser: ingen workers.dev- eller preview-adresser uden om vagten
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // hvert minut: Studio-opgaver · hvert kvarter: kalender og Otto · hver time: alarmer
  "triggers": { "crons": ["* * * * *", "*/15 * * * *", "0 * * * *"] },

  // Appen bag Cloudflare Access og API'et (/ext, /mcp) med tokens, som Studio og otto.heyotto.win
  "routes": [
    { "pattern": "tasks.heyotto.win", "custom_domain": true },
    { "pattern": "tasks-api.heyotto.win", "custom_domain": true }
  ],
  "vars": {
    "APP_URL": "https://tasks.heyotto.win",
    "UI_HOST": "tasks.heyotto.win",
    "API_HOST": "tasks-api.heyotto.win",
    "CF_ACCESS_TEAM_DOMAIN": "old-dust-74a9.cloudflareaccess.com",
    // AUD-tagget fra Access-applikationen for tasks.heyotto.win. Tom = appen er lukket (fail closed)
    "CF_ACCESS_AUD": "656cd582635a7cda8beb7255d3cd9b94f40bfd763bce88a3109df57839125f36"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "heyotto-tasks", "database_id": "08e498f7-7995-49ea-b11f-7aee188e455e", "migrations_dir": "migrations" }
  ],
  // /ext og /mcp: højst 60 kald i minuttet pr. token
  "ratelimits": [{ "name": "EXT_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "queues": {
    "producers": [{ "binding": "AGENT_QUEUE", "queue": "heyotto-tasks-otto" }],
    "consumers": [{ "queue": "heyotto-tasks-otto", "max_batch_size": 1, "max_retries": 0 }]
  }
}
