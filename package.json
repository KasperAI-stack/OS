{
  "name": "heyotto-tasks",
  "private": true,
  "description": "HeyOtto Tasks — appen og serveren bag den på Cloudflare Workers. Se dashboard/README.md.",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "web-push": "^3.6.7",
    "wrangler": "^4.158.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mts\"",
    "cf:dev": "wrangler dev --port 8799 --test-scheduled",
    "cf:migrate:local": "wrangler d1 migrations apply heyotto-tasks --local",
    "cf:migrate": "wrangler d1 migrations apply heyotto-tasks --remote",
    "cf:deploy": "wrangler deploy"
  }
}
